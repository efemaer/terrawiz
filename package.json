{
  "name": "terrawiz",
  "version": "1.0.0",
  "main": "dist/src/index.js",
  "bin": {
    "terrawiz": "dist/src/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/src/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "quality": "npm run type-check && npm run lint && npm run format:check && npm run test"
  },
  "keywords": [
    "terraform",
    "terragrunt",
    "github",
    "gitlab",
    "azure-devops",
    "bitbucket",
    "modules",
    "tracking",
    "iac",
    "infrastructure-as-code"
  ],
  "author": "Mansour Kheffache",
  "repository": "github:efemaer/terrawiz",
  "license": "MIT",
  "description": "A tool to track and analyze Terraform modules used in GitHub, GitLab, Azure DevOps, and Bitbucket repositories",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@gitbeaker/rest": "^43.5.0",
    "@octokit/core": "^7.0.2",
    "@octokit/plugin-throttling": "^11.0.1",
    "@octokit/rest": "^22.0.0",
    "@types/safe-regex": "^1.1.6",
    "commander": "^14.0.0",
    "dotenv": "^17.0.0",
    "safe-regex": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.4.0",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint": "^9.30.0",
    "jest": "^30.2.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "js-yaml": "^4.1.1"
  }
}
